int page = 0;  # should be within selenium class
Slots slots = Slots();
Players players = Players();
PauseController pause = PauseController();
Panic panic = Panic();



def main():

    login();  # multiple checkpoints

    while True:
        budget.update_budget();
        int upper_budget_limit = budget.get_budget_limit();

        clear_player_list();  # switch menus
        slots.update_available_slots();

        bool did_pause = False;
        if pause.do_auto_pause() or budget.do_budget_pause():
            did_pause = True;
            pause.auto_pause();

        elif !slots.available:
            did_pause = True;
            pause.forced_pause();

        if did_pause:
            slots.update_available_slots();
            if !slots.progress():
                slots.notify_human();

        array player_chunk = players.get_players(page, upper_budget_limit);  # Container: 30 players - information of one 'page'
        player_chunk = players.sort_player_chunk(player_chunk);  # match with current state of performance_barometer
        player_chunk = player_chunk[:random.randint(22, 30)]  # cut to random size

        for array player_information in player_chunk:

            if !slots.available:
                break;  # player loop

            Player player = Player(*player_information);
            int bought_counter = 0;

            int best_price = determine_best_price(player);  # plus minus kacka: die erste
            float optimized_price = best_price * .95;  # transaction fee
            enter_optimized_price();
            for int i in range(2):  # guarantee no loss
                lower_price();  # click minus to decrement price
            int best_optimized_price = get_best_optimized_price();


            for int trying_to_buy_player in range(50):

                if !slots.available or bought_counter > 2:
                    break;  # inner loop

                if trying_to_buy_player != 0:
                    refresh();  # plus minus kacka: die zweite
                if buy_player(best_optimized_price):
                    bought_counter++;
                    slots.available--;
                    sell_player();

            if bought_counter > 2:
                reward(player);  # aka player.performance++;
            elif !slots.available > 2:
                punish(player);  # aka player.performance--;

        page++;
        if page > todo add value: maybe read in?
            page = 0;


try:
    main();
except CriticalThresholdException:
    restart_app()
except ThresholdExceededException:
    restart_emu()

