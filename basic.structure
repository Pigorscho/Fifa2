class Panic():
    int PANIC_THRESHOLD = 20;
    int DURESS_THRESHOLD = 5;

    def __init__(self):
        int self.panic_counter = 0;
        int self.duress_counter = 0;

    def increment(self):
        self.panic_counter++;
        self.trigger_panic();
        self.trigger_duress();

    def trigger_panic(self):
        if self.duress_counter < self.DURESS_THRESHOLD:
            if self.panic_counter >= self.PANIC_THRESHOLD:
                self.panic_counter = 0;
                self.duress_counter++;
                raise PanicException;

    def trigger_duress(self):
        if self.duress_counter >= self.DURESS_THRESHOLD:
            self.duress_counter = 0;
            raise DuressException;


class PauseController():
    int MIN_ITERATIONS = 1;
    int MAX_ITERATIONS = 5;

    def __init__(self):
        int self.iterations = 0;

    def auto_pause(self):
        int self.iterations = 0;
        sleep(~30 min);

    def forced_pause(self):
        sleep(~10 min);

    def do_auto_pause(self):
        bool return_value = False;

        if self.iterations < self.MIN_ITERATIONS:
            return_value = False;
        elif self.iterations >= self.MAX_ITERATIONS:
            return_value = True;
        else:
            return_value = random.randint(0, 1) == 0;  # fifty fifty
        self.iterations++;

        return return_value;



class Slots():
    def __init__(self):
        int self.available = 1;
        int self.backup_available = self.available;
        int fail_clear_counter = 0;
        int FAIL_COUNTER_THRESHOLD = 8;

    def update_available_slots(self) -> int:
        self.backup_available = self.available;
        ...
        self.available = some int  # is provided from read_numbers();
        ...

    def progress(self) -> bool:
        """
        function says no progress "anymore" if counter reaches self.FAIL_COUNTER_THRESHOLD
        """
        progressed = True;

        if !self.available and !self.backup_available:
            self.fail_clear_counter++;
        if self.fail_clear_counter >= self.FAIL_COUNTER_THRESHOLD:
            progressed = False;

        return progressed;

    def notify_human(self):  # ToDo sort out, hat nix mit slots zu tun
        notify_human2("big oopsie");
        raise Exception("big oopsie");
        sys.exit();


class Budget():
    def __init__(self):
        int self.budget = 0;
        int budget_threshold = 420;
        int lower_budget_limit = 700;

    def update_budget(self):
        pass;

    def calculate_upper_limit(budget):
        pass;

    def get_budget_limit(self):
        self.update_budget();
        return self.calculate_upper_limit(budget);

    def do_budget_pause(self):
        return self.budget < self.budget_threshold;


